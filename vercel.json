{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/landing/index.html" },
    { "source": "/style.css", "destination": "/landing/style.css" },
    { "source": "/app.js", "destination": "/landing/app.js" },
    { "source": "/assets/(.*)", "destination": "/landing/assets/$1" },
    { "source": "/downloads/(.*)", "destination": "/landing/downloads/$1" },
    { "source": "/(.*)", "destination": "/landing/$1" }
  ]
}
